# Use the dedicated hackathon PAPER account's key and secret.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Official Alpaca CLI and MCP server paper-mode settings, respectively.
ALPACA_LIVE_TRADE=false
ALPACA_PAPER_TRADE=true

# Featherless inference; enter the real key only in the Git-ignored .env.
FEATHERLESS_API_KEY=
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=zai-org/GLM-5
LLM_COMPARISON_MODEL=deepseek-ai/DeepSeek-V4-Flash
